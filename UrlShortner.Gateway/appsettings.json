{
    "ReverseProxy": {
        "Routes": {
            "auth-route": {
                "ClusterId": "auth-cluster",
                "Match": {
                    "Path": "/api/Auth/{**catch-all}",
                    "Methods": [ "GET", "POST" ]
                }
            },
            "write-route": {
                "ClusterId": "write-cluster",
                "AuthorizationPolicy": "default",
                "Match": {
                    "Path": "/api/UrlShortner/{all}",
                    "Methods": [ "POST", "PUT", "DELETE", "PATCH" ]
                }
            },
            "read-route": {
                "ClusterId": "read-cluster",
                "AuthorizationPolicy": "default",
                "Match": {
                    "Path": "/api/UrlShortner/{**catch-all}",
                    "Methods": [ "GET" ]
                }
            },
            "redirect-route": {
                "ClusterId": "read-cluster",
                "Match": {
                    "Path": "/api/UrlShortner/{code:regex(^[a-zA-Z0-9]+$)}",
                    "Methods": [ "GET" ]
                }
            }
        },
        "Clusters": {
            "auth-cluster": {
                "Destinations": {
                    "auth-1": {
                        "Address": "https://localhost:7110/"
                    }
                }
            },
            "write-cluster": {
                "Destinations": {
                    "write-1": { "Address": "https://localhost:7136/" }
                }
            },
            "read-cluster": {
                "LoadBalancingPolicy": "RoundRobin",
                "Destinations": {
                    "read-1": { "Address": "https://localhost:7136/" },
                    "read-2": { "Address": "https://localhost:7136/" }
                }
            }
        }
    },
    "Jwt": {
        "Key": "7WZCDeTK1Q7h5gvNRC5PvexhuW5XWHNS",
        "Issuer": "UrlShortener.Auth",
        "Audience": "UrlShortener.Api"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
